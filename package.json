{
  "name": "rh-minter",
  "version": "1.0.0",
  "type": "module",
  "description": "Minimal contract minting bot for Robinhood Chain (Arbitrum L2, EVM-compatible)",
  "scripts": {
    "inspect": "node src/inspect.js",
    "dryrun": "node src/mint.js --dry-run",
    "mint": "node src/mint.js",
    "ui": "bun src/server.js",
    "start": "bun src/server.js",
    "ui:node": "node src/server.js",
    "test": "node --test --test-timeout=30000 tests/",
    "test:historical": "node scripts/historical-verify.js",
    "test:pipeline": "node scripts/pipeline-replay.js",
    "test:agg-fixtures": "node scripts/verify-aggregator-fixtures.js",
    "prearm": "node scripts/prearm-check.js",
    "soak": "node scripts/detect-soak.js"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "ethers": "^6.13.2",
    "goat-x-pro": "^0.1.1",
    "x-client-transaction-id": "^0.3.1"
  }
}
