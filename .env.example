# ---- WALLET (signing needs this; use a burner) ----
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# ---- NETWORK (Robinhood Chain mainnet) ----
RPC_URL=https://rpc.mainnet.chain.robinhood.com
CHAIN_ID=4663
# Alchemy for speed/reliability — paste the FULL endpoint URL from your app:
ALCHEMY_KEY=
ALCHEMY_URL=

# ---- CONTRACT (Script Kiddies — thirdweb DropERC721) ----
CONTRACT_ADDRESS=0x51363a6520563Be4D029E9e7523d9F348A21298A
MINT_QUANTITY=1
# Only used for manual patterns (mint/mintTo). thirdweb reads price on-chain.
PRICE_PER_UNIT_ETH=0
# NOTE: price + currency are read from the active claim condition on-chain.
# You do NOT set a price here — the bot uses whatever the live phase requires.

# ---- GAS (FCFS chain: gas doesn't buy priority; cap only) ----
MAX_GAS_USD=15
ETH_USD=3000
GAS_LIMIT=

# ---- TIMING ----
WAIT_FOR_ONCHAIN=true
MINT_AT=
POLL_MS=80

# ---- UI (only if hosting publicly) ----
# DASH_TOKEN=set-a-long-random-string-if-exposing-the-UI-publicly

# ---- AUTO-BUY FROM X (Uniswap v4 swaps) ----
# V4 Quoter on Robinhood Chain — required for swap quotes
V4_QUOTER=
# X session cookies for goat-x-pro (use ONE — never commit)
# X_COOKIES_PATH=./cookies.json
# X_COOKIES_JSON=[{"name":"auth_token","value":"...","domain":".x.com"}]
AUTO_POLL_SEC=30

# ---- LIVE ON-CHAIN LAUNCH SCANNER (PRIMARY) ----
# WebSocket for block events — paste full wss URL from Alchemy (never commit)
ALCHEMY_WSS_URL=
CHAIN_SCAN_ENABLED=true
TARGET_SYMBOL=CLOCKIN
# Route retry when token exists before pool (ms)
CHAIN_ROUTE_RETRY_MS=100
CHAIN_ROUTE_RETRY_WINDOW_MS=120000
# HTTP fallback poll when WSS unavailable (separate from AUTO_POLL_SEC)
CHAIN_HTTP_POLL_MS=2000
# Production live ARM requires healthy WSS. Set true only to intentionally arm HTTP-only.
ALLOW_HTTP_ONLY_LIVE=false
AUTOBUY_AUDIT_PATH=./autobuy-events.jsonl

# ---- AGGREGATOR ROUTING (Robinhood routing proxy) ----
AGGREGATOR_ENABLED=true
AGGREGATOR_PROXY=0x65050A9b7E5075A2bA5cED7b1b64EE66262c40Dc
AGGREGATOR_EXPECTED_IMPL=0xb70DA7425Bc26A6aFd60d080148248389a9073bF
AGGREGATOR_DEADLINE_SEC=60
AGGREGATOR_FEE_BPS=100
MAX_LAUNCH_TAX_PCT=15
MAX_CANDIDATE_PIPELINES=8
