# ---- WALLET (signing needs this; use a burner) ----
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# ---- NETWORK (Robinhood Chain mainnet) ----
RPC_URL=https://rpc.mainnet.chain.robinhood.com
CHAIN_ID=4663
# Alchemy for speed/reliability — paste the FULL endpoint URL from your app:
ALCHEMY_KEY=
ALCHEMY_URL=

# ---- CONTRACT (Script Kiddies — thirdweb DropERC721) ----
CONTRACT_ADDRESS=0x51363a6520563Be4D029E9e7523d9F348A21298A
MINT_QUANTITY=1
# Only used for manual patterns (mint/mintTo). thirdweb reads price on-chain.
PRICE_PER_UNIT_ETH=0
# NOTE: price + currency are read from the active claim condition on-chain.
# You do NOT set a price here — the bot uses whatever the live phase requires.

# ---- GAS (FCFS chain: gas doesn't buy priority; cap only) ----
MAX_GAS_USD=15
ETH_USD=3000
GAS_LIMIT=

# ---- TIMING ----
WAIT_FOR_ONCHAIN=true
MINT_AT=
POLL_MS=80

# ---- UI (only if hosting publicly) ----
# DASH_TOKEN=set-a-long-random-string-if-exposing-the-UI-publicly

# ---- AUTO-BUY FROM X (Uniswap v4 swaps) ----
# V4 Quoter on Robinhood Chain — required for swap quotes
V4_QUOTER=
# X session cookies for goat-x-pro (use ONE — never commit)
# X_COOKIES_PATH=./cookies.json
# X_COOKIES_JSON=[{"name":"auth_token","value":"...","domain":".x.com"}]
